# VCS / tooling
.git
.github
.gitignore
.pre-commit-config.yaml
.pytest_cache
.mypy_cache

# local dev environments
.venv

# build artifacts
# The generated root build/ directory is the canonical Docker input. The
# temporary site/ staging directory is not needed in the image context.
dist
site
*.egg-info
demos/_wheel
!build/
!build/**

# Runtime bundles are copied from build/ above; do not duplicate the source
# cache under demos/_assets/ in the Docker context.
demos/_assets/pyodide
demos/_assets/wheels

# tests, docs and aux content are not needed at runtime
test
documentation
openspec
pyknit-logolong.png
.readthedocs.yml
.flake8

# bytecode / editor cruft
__pycache__
*.pyc
*.pyo
*.swp
*~
.DS_Store